-dark,var(--sdm-c,inherit))]" style="--sdm-c: #6F42C1; --shiki-dark: #B392F0;">class</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">=</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #032F62; --shiki-dark: #9ECBFF;">"post-source"</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;Source: &lt;</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #22863A; --shiki-dark: #85E89D;">a</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #6F42C1; --shiki-dark: #B392F0;">href</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">=</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #032F62; --shiki-dark: #9ECBFF;">"{{ page.source }}"</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;original report&lt;/</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #22863A; --shiki-dark: #85E89D;">a</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;&lt;/</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #22863A; --shiki-dark: #85E89D;">p</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;</span></span><span class="block before:content-[counter(line)] before:inline-block before:[counter-increment:line] before:w-6 before:mr-4 before:text-[13px] before:text-right before:text-muted-foreground/50 before:font-mono before:select-none"><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">  {% endif %}</span></span><span class="block before:content-[counter(line)] before:inline-block before:[counter-increment:line] before:w-6 before:mr-4 before:text-[13px] before:text-right before:text-muted-foreground/50 before:font-mono before:select-none"><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&lt;/</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #22863A; --shiki-dark: #85E89D;">article</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;</span></span></code></pre></div></div>
<p>That <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">{% if %}</code> wrapper is the important part. It checks whether a post has a <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">source</code> field before rendering anything — so articles without one show nothing, rather than an empty "Source:" line. That means you can add sources to some posts and not others without it looking broken.</p>
<p><span class="font-semibold" data-streamdown="strong">Step 3 — style it, optionally.</span> In <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">style.scss</code>, add:</p>
<div class="my-4 flex w-full flex-col gap-2 rounded-xl border border-border bg-sidebar p-2" data-language="scss" data-streamdown="code-block" style="content-visibility: auto; contain-intrinsic-size: auto 200px;"><div class="flex h-8 items-center text-muted-foreground text-xs" data-language="scss" data-streamdown="code-block-header"><span class="ml-1 font-mono lowercase">scss</span></div><div class="pointer-events-none sticky top-2 z-10 -mt-10 flex h-8 items-center justify-end"><div class="pointer-events-auto flex shrink-0 items-center gap-2 rounded-md border border-sidebar bg-sidebar/80 px-1.5 py-1 supports-[backdrop-filter]:bg-sidebar/70 supports-[backdrop-filter]:backdrop-blur" data-streamdown="code-block-actions"><button class="cursor-pointer p-1 text-muted-foreground transition-all hover:text-foreground disabled:cursor-not-allowed disabled:opacity-50" data-streamdown="code-block-download-button" title="Download file" type="button"><svg color="currentColor" height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" size="14"><path clip-rule="evenodd" d="M8.75 1V1.75V8.68934L10.7197 6.71967L11.25 6.18934L12.3107 7.25L11.7803 7.78033L8.70711 10.8536C8.31658 11.2441 7.68342 11.2441 7.29289 10.8536L4.21967 7.78033L3.68934 7.25L4.75 6.18934L5.28033 6.71967L7.25 8.68934V1.75V1H8.75ZM13.5 9.25V13.5H2.5V9.25V8.5H1V9.25V14C1 14.5523 1.44771 15 2 15H14C14.5523 15 15 14.5523 15 14V9.25V8.5H13.5V9.25Z" fill="currentColor" fill-rule="evenodd"></path></svg></button><button class="cursor-pointer p-1 text-muted-foreground transition-all hover:text-foreground disabled:cursor-not-allowed disabled:opacity-50" data-streamdown="code-block-copy-button" title="Copy Code" type="button"><svg color="currentColor" height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" size="14"><path clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25