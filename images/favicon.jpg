 items, {failed} failed\",\"toast_delete_failed\":\"Couldn’t delete the items. Please try again.\",\"toast_create_failed\":\"Couldn’t create the collection. Please try again.\",\"empty_root_title\":\"Add your first files\",\"empty_root_description\":\"Upload files or create a collection to organize your work.\",\"empty_root_create\":\"Create collection\",\"collections_and_files\":\"Collections and Files\",\"rename_file_modal_title\":\"Rename File\",\"cancel_upload\":\"Cancel upload\"},\"GeneratedFilePreview\":{\"new_project\":\"New project\",\"project_name_placeholder\":\"Project name\",\"create\":\"Create\",\"already_in_project_title\":\"File already in project\",\"already_in_project_description\":\"{filename} is already in {projectName}. Add it again?\",\"add_anyway\":\"Add anyway\",\"cancel\":\"Cancel\",\"add_to_project\":\"Add to project\",\"added_to_project\":\"Added to {projectName}\",\"add_to_project_failed\":\"Couldn't add file to project\",\"new_collection\":\"New collection\",\"collection_name_placeholder\":\"Collection name\",\"already_in_collection_title\":\"File already in collection\",\"already_in_collection_description\":\"{filename} is already in {collectionName}. Add it again?\",\"add_to_collection\":\"Add to collection\",\"added_to_collection\":\"Added to {collectionName}\",\"add_to_collection_failed\":\"Couldn't add file to collection\",\"add_to_project_or_collection\":\"Add to project or collection\",\"open_file\":\"Open File\",\"download\":\"Download\",\"close\":\"Close preview\",\"loading\":\"Loading preview…\",\"error_load\":\"Could not load preview.\",\"download_instead\":\"Download file\",\"preview_unavailable\":\"Preview not available for this file type.\"},\"UnifiedPaywall\":{\"feat_chatgpt\":\"Access to the ChatGPT 5 family \u0026 others\",\"feat_claude\":\"Access to Claude Opus, Sonnet \u0026 Haiku families\",\"feat_grok\":\"Access to Grok \u0026 DeepSeek families\",\"feat_nanobanana\":\"Access to NanoBanana Pro \u0026 others\",\"feat_generate\":\"Generate images, PDFs, Slides, Sheets, Documents\",\"feat_connect\":\"Connect with 100+ tools like Notion, Slack \u0026 more\",\"feat_collections\":\"Create collections of documents \u0026 files\",\"feat_projects\":\"Set up projects, AI agents \u0026 knowledge bases\",\"feat_research_500\":\"Web \u0026 Deep Research with 500 sources analysed\",\"feat_desktop_ios\":\"Available on Desktop \u0026 iOS\",\"check_max_tokens_10x\":\"10× more daily tokens\",\"check_heavy_users\":\"Best fit for heavy users\",\"check_fast_image\":\"Faster image generation\",\"check_memory\":\"Maximum memory and context\",\"check_fable\":\"Access to Fable (when it's back)\",\"check_early_access\":\"Early access to experimental features\",\"check_research_1000\":\"Deep Research with 1,000+ sources\",\"error_signed_out\":\"You've been signed out. Sign in again to continue.\",\"error_session_failed\":\"Failed to create payment session\",\"toast_success\":\"Subscription updated\",\"offer_pro_trial\":\"7-Day Full Access\",\"offer_quarterly\":\"Quarterly\",\"offer_6mo\":\"6-Month\",\"offer_monthly\":\"Monthly\",\"unit_per_month\":\"per month\",\"save\":\"Save {amount}%\",\"title_upgrade_pro\":\"Upgrade account to Pro\",\"title_upgrade_max\":\"Upgrade account to Max 5x\",\"title_on_max\":\"You are on the Max 5x plan\",\"title_downgrade_to_pro\":\"Downgrade to Pro\",\"title_update_plan\":\"Update your plan\",\"title_upgrade_plan\":\"Upgrade your plan\",\"title_token_limit\":\"You have reached your daily usage limit\",\"title_trial_limit\":\"You have reached your trial daily messages limit\",\"title_on_trial\":\"Upgrade to a full plan\",\"title_subscription_cancelled\":\"Choose your plan\",\"title_activate_subscription\":\"Activate your subscription\",\"banner_scheduled_downgrade\":\"Your plan is scheduled to change from {fromPlanName} to {toPlanName} on {date}.\",\"plan_name_trial\":\"Trial\",\"plan_name_pro_monthly\":\"Monthly Pro\",\"plan_name_pro_quarterly\":\"Quarterly Pro\",\"plan_name_pro_half_yearly\":\"6-Month Pro\",\"plan_name_max_monthly\":\"Monthly Max\",\"plan_name_max_quarterly\":\"Quarterly Max\",\"plan_name_max_half_yearly\":\"6-Month Max\",\"banner_max\":\"Get 5x the weekly usage, faster reasoning, and much more.\",\"sub_pro_limit\":\"Your daily usage limit resets at 00:00. Upgrade to the Max plan for 5× more daily usage.\",\"sub_max_limit\":\"Your daily usage limit resets at 00:00.\",\"sub_trial_limit\":\"Activate your subscription now to continue using your account or wait until tomorrow. Your daily usage limit resets at 00:00.\",\"sub_on_trial\":\"Move from daily trial limits to weekly usage allowances on Pro or Max 5x.\",\"col_pro\":\"Pro\",\"col_max\":\"Max\",\"col_free\":\"Free\",\"toggle_pro\":\"Update Pro\",\"toggle_max\":\"Update Max 5x\",\"toggle_upgrade_pro\":\"Upgrade to Pro\",\"toggle_upgrade_max\":\"Upgrade to Max 5x\",\"toggle_downgrade\":\"Downgrade to Pro\",\"warn_dunned\":\"Your last payment failed and your subscription was automatically cancelled. Update your payment method or choose a new plan below.\",\"current_plan\":\"Current plan\",\"current_subscription\":\"Current subscription\",\"disc_prorated\":\"\u003cb\u003eYou'll be charged a prorated amount today.\u003c/b\u003e Then you will be billed \u003cb\u003e{price} {period}\u003c/b\u003e until you cancel.\",\"disc_subscription\":\"You'll be charged the listed price for your selected plan until you cancel.\",\"disc_trial\":\"Get a 7-day trial for just {trialPrice}. After trial, \u003cb\u003ewe'll charge you {monthlyPrice} every month until you cancel.\u003c/b\u003e\",\"disc_plan\":\"On the {packageName} package, \u003cb\u003ewe will charge you {price} {period} until you cancel.\u003c/b\u003e\",\"period_month\":\"every month\",\"period_3_months\":\"every 3 months\",\"period_6_months\":\"every 6 months\",\"disc_current\":\"\u003cb\u003eThis is your current plan.\u003c/b\u003e Renews at {price} {period} on {renewDate}.\",\"disc_switch\":\"Your plan switches to {billingLabel} when your current {currentCycleLabel} plan ends on {endDate}. \u003cb\u003eYou'll then be charged {totalPrice} {periodLabel}\u003c/b\u003e until you cancel.\",\"pay_now\":\"Pay now\",\"pay_reactivate\":\"Pay now and reactivate\",\"update_plan_now\":\"Update my plan now\",\"retry\":\"Try again\",\"due_today\":\"Due today\",\"subtitle\":\"Full access to premium AI models, image generation, and file analysis.\",\"billing_label_monthly\":\"monthly billing\",\"billing_label_quarterly\":\"quarterly billing\",\"billing_label_6mo\":\"6-month billing\",\"current_cycle_monthly\":\"monthly\",\"current_cycle_quarterly\":\"quarterly\",\"current_cycle_6mo\":\"6-month\",\"label_scheduled\":\"Scheduled\",\"tooltip_ai_agents\":\"For example, ask your agent to check your calendar and email available time slots to your contact.\",\"tooltip_connect_apps\":\"Connect to apps like Gmail, Google Calendar, Drive, Microsoft Teams, Outlook, Zapier, Notion, Slack and many more.\",\"check_everything_in_pro_rich\":\"Everything in Pro, plus:\",\"check_5x_daily_usage_rich\":\"\u003cb\u003e5× the daily usage\u003c/b\u003e\",\"check_max_reasoning_rich\":\"\u003cb\u003eMaximum reasoning\u003c/b\u003e — more thinking time on hard math, code and analysis\",\"check_max_deep_research_rich\":\"\u003cb\u003eMaximum Deep Research\u003c/b\u003e — up to 1,000 cited sources per report\",\"check_faster_image_rich\":\"\u003cb\u003eFaster image generation\u003c/b\u003e — priority at the provider\",\"check_max_memory_rich\":\"\u003cb\u003eMaximum memory \u0026 context\u003c/b\u003e — the biggest window each model allows\",\"check_early_access_rich\":\"\u003cb\u003eEarly access to new features\u003c/b\u003e — new models and tools first\",\"title_change_plan\":\"Change your plan\",\"sub_change_plan\":\"Switch your plan or billing period anytime.\",\"disc_renewal\":\"We'll charge you \u003cb\u003e{price}\u003c/b\u003e today to renew your \u003cb\u003e{planName}\u003c/b\u003e plan.\",\"switch_to_plan_button\":\"Switch to {planName}\",\"upgrade_to_plan_button\":\"Upgrade to {planName}\",\"reactivate_scheduled_description\":\"You'll keep full access to {planName} until {date}. Reactivate now to continue without interruption.\",\"already_scheduled\":\"Already scheduled\"},\"ManagePlan\":{\"title\":\"Change your plan\",\"current_plan_label\":\"Current plan: {plan}\",\"tier_pro\":\"Pro\",\"tier_max\":\"Max\",\"card_monthly\":\"Monthly\",\"card_quarterly\":\"Quarterly\",\"card_6mo\":\"6 Months\",\"per_month\":\"per month\",\"daily_tokens\":\"Daily tokens\",\"daily_value\":\"{amount}/day\",\"billed\":\"Billed\",\"billed_monthly\":\"{price} every month\",\"billed_quarterly\":\"{price} every quarter\",\"billed_6mo\":\"{price} every 6 months\",\"save\":\"Save {amount}%\",\"btn_current\":\"Current plan\",\"btn_selected\":\"Selected\",\"btn_select\":\"Select\",\"btn_unavailable\":\"Unavailable\",\"due_today\":\"Due today\",\"amount_zero\":\"$$0.00\",\"confirm_change\":\"Confirm plan change\",\"confirm_pay\":\"Pay now \u0026 confirm plan change\",\"retry\":\"Try again\",\"saved_card_placeholder\":\"Saved payment method\",\"change_card\":\"Change\",\"change_card_soon\":\"Changing your payment method is coming soon\",\"disc_scheduled\":\"No charge today. Your plan switches to \u003cb\u003e{plan}\u003c/b\u003e on \u003cb\u003e{date}\u003c/b\u003e. Starting from that date, we will charge you \u003cb\u003e{cadence}\u003c/b\u003e until you cancel. Price excludes tax.\",\"disc_prorated\":\"We're going to charge you a prorated payment for your current \u003cb\u003e{current}\u003c/b\u003e plan of \u003cb\u003e{chargeNow}\u003c/b\u003e. Then \u003cb\u003e{cadence}\u003c/b\u003e until you cancel. Price excludes tax.\",\"toast_changed\":\"Your plan has been changed\",\"toast_scheduled\":\"Your plan change is scheduled\",\"error_user_not_found\":\"We couldn't verify your account. Please refresh and try again.\",\"error_session_failed\":\"We couldn't start the payment. Please try again.\",\"error_change_failed\":\"We couldn't change your plan. Please try again.\"},\"ProjectsManagement\":{\"page_title\":\"Projects\",\"add_project\":\"New project\",\"search_placeholder\":\"Search projects\",\"empty_title\":\"No projects yet\",\"empty_description\":\"Create a project to organize your chats and files\",\"updated_ago\":\"Updated {time} ago\",\"updated_years_ago\":\"Updated {count, plural, one {# year} other {# years}} ago\",\"updated_more_than_years_ago\":\"Updated more than {count, plural, one {# year} other {# years}} ago\",\"rename\":\"Rename\",\"delete\":\"Delete\",\"delete_error\":\"Failed to delete project\",\"project_menu\":\"Project options\",\"pin\":\"Pin\",\"unpin\":\"Unpin\",\"toast_project_pinned\":\"Project is pinned\"},\"UnsupportedExtensionsModal\":{\"title\":\"{extension} Format Not Supported\",\"description\":\"The selected model doesn't support {extension} processing. Please switch to Gemini for the best performance in {extension} processing and analysis.\",\"cancel\":\"Cancel\",\"switch_to_fallback_model\":\"Switch to Gemini\"},\"PricingPage\":{\"hero_title\":\"The latest AI models. One app.\",\"hero_subtitle\":\"When a new AI model comes out, you get it — automatically.\",\"toggle_monthly\":\"Monthly\",\"toggle_quarterly\":\"Quarterly\",\"toggle_half_yearly\":\"6 months\",\"toggle_discount\":\"-{percent}\",\"unit_per_month\":\"/ month\",\"plan_free_name\":\"Free\",\"plan_free_tagline\":\"See what it's like\",\"plan_free_note\":\"No credit card required\",\"plan_free_disclaimer\":\"Fair use applies. \u003clink\u003eLearn more\u003c/link\u003e\",\"plan_pro_name\":\"Pro\",\"plan_pro_tagline\":\"Everything, every day\",\"plan_pro_disclaimer\":\"Usage limits apply. \u003clink\u003eLearn more\u003c/link\u003e\",\"plan_max_name\":\"Max\",\"plan_max_tagline\":\"Our highest limits\",\"plan_max_disclaimer\":\"Usage limits apply. \u003clink\u003eLearn more\u003c/link\u003e\",\"cta_pro_trial\":\"Try {days} days for {price}\",\"trial_available\":\"Trial available\",\"billed_total_quarterly\":\"{total} billed every 3 months\",\"billed_total_half_yearly\":\"{total} billed every 6 months\",\"billed_monthly\":\"Billed monthly\",\"cta_free\":\"Get started\",\"cta_pro\":\"Get Pro\",\"cta_max\":\"Get Max\",\"cancel_anytime\":\"Cancel anytime\",\"footnote_limits\":\"Usage limits apply\",\"everything_in_free\":\"Everything in Free, plus:\",\"everything_in_pro\":\"Everything in Pro, plus:\",\"free_feature_chat\":\"Everyday AI chat\",\"free_feature_usage\":\"Limited usage \u0026 capacity\",\"free_feature_search\":\"Limited web search\",\"free_feature_platforms\":\"Web, iOS \u0026 Android\",\"pro_feature_models\":\"Premium AI models\",\"pro_feature_projects\":\"Projects \u0026 knowledge bases\",\"pro_feature_switching\":\"Switch models mid-chat\",\"pro_feature_images\":\"Image generation with the latest AI models\",\"pro_feature_research\":\"Deep Research\",\"pro_feature_files\":\"Create documents, slides \u0026 sheets\",\"pro_feature_connectors\":\"Connect 100+ apps\",\"max_feature_usage\":\"5× the usage allowance\",\"max_feature_reasoning\":\"Maximum reasoning\",\"max_feature_research\":\"Maximum Deep Research\",\"max_feature_images\":\"Faster image generation\",\"max_feature_memory\":\"Maximum memory \u0026 context\",\"max_feature_early\":\"Early access to new features\",\"comparison_title\":\"Compare features across plans\",\"comparison_col_free\":\"Free\",\"comparison_col_pro\":\"Pro\",\"comparison_col_max\":\"Max\",\"section_essentials\":\"Essentials\",\"section_models\":\"Chat\",\"section_create\":\"Create\",\"section_research\":\"Research \u0026 tools\",\"row_response_times\":\"Response times\",\"row_switching\":\"Switch models mid-chat\",\"row_leading_chat\":\"Chat with leading AI models\",\"row_premium_models\":\"Premium AI models\",\"row_history\":\"Chat history\",\"row_everyday_model\":\"Use AI Instant\",\"row_new_flagships\":\"New models as they come out\",\"row_reasoning\":\"Reasoning effort\",\"row_images\":\"Image generation with leading AI models\",\"row_files\":\"Documents, PDFs, slides \u0026 sheets\",\"row_web_search\":\"Web search\",\"row_deep_research\":\"Deep Research\",\"row_connectors\":\"100+ app connectors\",\"row_agents\":\"AI agents\",\"row_projects\":\"Projects\",\"row_knowledge\":\"Knowledge bases\",\"row_file_storage\":\"File library\",\"row_platforms\":\"Access on Web, iOS \u0026 Android\",\"row_memory\":\"Memory \u0026 context\",\"row_early_access\":\"Early access to new features\",\"cell_limited\":\"Limited\",\"cell_low\":\"Low\",\"cell_high\":\"High [3]\",\"cell_unlimited\":\"Unlimited [1]\",\"cell_unlimited_plain\":\"Unlimited\",\"cell_bandwidth\":\"Limited on availability\",\"cell_fast\":\"Fast [2]\",\"cell_5x\":\"5× Pro\",\"cell_coming_soon\":\"Coming soon\",\"cell_priority\":\"Faster [4]\",\"cell_research_pro\":\"Up to 200 sources\",\"cell_research_max\":\"Up to 1,000 sources\",\"cell_standard\":\"Included [1]\",\"cell_maximum_reasoning\":\"Maximum [3]\",\"cell_standard_memory\":\"Standard [2]\",\"cell_maximum_memory\":\"Maximum [2]\",\"faq_title\":\"Frequently asked questions\",\"faq_providers_q\":\"Are you going to add more AI providers?\",\"faq_providers_a\":\"Yes. When a lab ships a model that's on par with or better than our current lineup, we add it. Flagships from the leading labs are added as they're released.\",\"faq_release_q\":\"How fast do you release new models?\",\"faq_release_a\":\"We usually release new models within 24 hours of their becoming available to the general public.\",\"faq_accounts_q\":\"Do I need my own OpenAI or Anthropic account?\",\"faq_accounts_a\":\"No. One Use AI subscription covers everything — we already have access to the labs' models through their APIs, so you don't need separate accounts or other subscriptions.\",\"faq_deep_research_q\":\"What is Deep Research?\",\"faq_deep_research_a\":\"Deep Research scans and analyzes hundreds of web sources on your question, then builds a structured report with citations for every claim — so you can verify everything it says. On Pro it analyzes up to 200 sources per report; on Max, up to 1,000.\",\"faq_reasoning_q\":\"What does reasoning effort mean?\",\"faq_reasoning_a\":\"Reasoning effort is how long a model thinks before it answers — more effort means more careful answers to complex questions, like math, code, and analysis. You can adjust it per chat; your plan sets the ceiling: Free runs at low effort, Pro at high, and Max at maximum.\",\"faq_agents_q\":\"What are AI agents and connectors?\",\"faq_agents_a\":\"Connectors link Use AI to 100+ apps like Notion, Slack, and Gmail. AI agents use those connections to get things done for you — searching your tools, browsing the web, and completing multi-step tasks, always with your permission.\",\"faq_projects_q\":\"What are projects and knowledge bases?\",\"faq_projects_a\":\"Projects keep related chats, files, and instructions together in one workspace. A knowledge base is the set of documents you add to a project — the AI uses them as context, so you don't have to re-upload or re-explain anything.\",\"faq_trial_q\":\"How does the trial work?\",\"faq_trial_a\":\"In eligible regions, new users can try Pro for 7 days at the introductory price shown on the Pro card. After the trial, it renews at the regular monthly price unless you cancel first. You can cancel anytime in your profile settings — cancel before the trial ends and you won't be charged again.\",\"faq_plan_changes_q\":\"Can I change my plan later?\",\"faq_plan_changes_a\":\"Yes. You can upgrade anytime and it takes effect right away. Downgrades and billing-period changes apply at the end of your current cycle.\",\"faq_usage_q\":\"How do usage limits work?\",\"faq_usage_a\":\"Each paid plan includes a set amount of premium AI model usage, applied as a weekly allowance — daily during a free trial. The mechanics — what counts, how to track it, and your options at the limit — are in the Help Center article 'How usage limits work', linked from the footnotes under the comparison table; the Fair Usage Policy in the Help Center covers the fair-use terms. Message estimates on this page assume a typical message — about 1,500 tokens of conversation context plus a ~750-token reply — at official list prices.\",\"faq_cancel_q\":\"Can I cancel anytime?\",\"faq_cancel_a\":\"Yes. You can cancel anytime from your profile settings, and your plan stays active until the end of the current billing period. Your chats and files stay in your account, and you keep Free access.\",\"footnote_fair_usage\":\"Each plan includes a monthly usage allowance for premium AI models. The limit is applied weekly on paid plans — and daily during a trial — proportional to your monthly allowance. Messaging with Use AI Instant is unlimited on paid plans, subject to fair use.\",\"footnote_fair_usage_link\":\"Learn more\",\"footnote_see_also_policy\":\"See also the \u003clink\u003eFair Usage Policy\u003c/link\u003e.\",\"footnote_tax\":\"Prices exclude tax.\",\"table_note_reasoning\":\"[3] Reasoning effort is how long a model thinks before it answers — more effort means more careful answers to complex questions: better math, code, and analysis. Free runs at low effort, Pro at high, and Max at maximum. Models without adjustable reasoning run at their default setting.\",\"table_note_model_variance\":\"[2] Response times and memory \u0026 context vary by model — per-plan context windows apply where the model provider supports them, and each model has its own speed and maximum context window.\",\"table_note_priority\":\"[4] For faster image generation, we ask the model provider to prioritize your request — prioritization itself is not guaranteed.\",\"row_weekly_usage\":\"Premium model usage\",\"row_addon_usage\":\"Usage Boost\",\"free_feature_instant\":\"Generous everyday chat with Use AI Instant\",\"pro_feature_instant\":\"Unlimited messaging with Use AI Instant\",\"faq_instant_q\":\"What happens when I hit my usage limit?\",\"faq_instant_a\":\"You never lose the ability to chat. Messaging with Use AI Instant — our fast everyday model — is unlimited on Pro and Max (with guardrails against automated abuse) and doesn't count toward your usage allowance. If you reach your weekly premium limit, switch to Use AI Instant and keep going — your allowance resets each week. During a free trial, the allowance is daily.\",\"faq_credits_q\":\"Can I buy more usage?\",\"faq_credits_a\":\"Usage Boost — a usage top-up for Pro and Max — is coming soon. Until then, you can upgrade to Max for 5× the weekly allowance, or keep chatting with Use AI Instant.\",\"calc_title\":\"How many messages does a plan buy?\",\"calc_subtitle\":\"Here's what each plan buys, model by model — and where unlimited kicks in.\",\"calc_mode_chat\":\"Chat\",\"calc_mode_images\":\"Images\",\"calc_unlimited\":\"Unlimited\",\"calc_instant_badge\":\"Never counts toward your usage\",\"calc_instant_note\":\"Out of premium usage? Switch to {model} and keep chatting — messaging with it is unlimited on Pro and Max, subject to fair use.\",\"calc_footnote_images\":\"Image estimates assume one standard-quality image (~1024px) per generation, at official list prices in USD. Higher quality settings use more.\",\"calc_footnote_estimates\":\"Estimates only — actual counts vary with conversation length, attachments, reasoning effort and web search. Fair usage limits apply.\",\"calc_cell_month\":\"≈ {count} / mo\",\"calc_cell_week\":\"≈ {count} / wk\",\"calc_max_only\":\"Max only\",\"row_everyday_chats\":\"Everyday text chats\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":[\"$L23\",\"$L24\"]}]\n25:I[\"cc89454c4776\",[],\"FreemiumFunnelProvider\",1]\n26:I[\"70daafca3bcb\",[],\"ComposerModesProvider\",1]\n27:I[\"a8ee05278836\",[],\"ConnectorIntlProvider\",1]\n28:I[\"ecb83ceda087\",[],\"default\",1]\n20:[\"$\",\"$L21\",null,{}]\n23:[\"$\",\"$L25\",null,{\"value\":false,\"children\":[\"$\",\"$L26\",null,{\"chatModel\":\"gateway-instant\",\"modes\":{\"si