ly confirmed.\",\"toast_title_email_changed\":\"Email Updated!\",\"toast_description_email_changed\":\"Your email address has been successfully updated.\",\"api_resend_email_send_failed\":\"Failed to send confirmation email. Please try again later.\",\"verify_email_modal_rate_limit_reached\":\"Too many requests\"},\"NotFound\":{\"not_found_title\":\"404\",\"not_found_heading\":\"Page not found\",\"not_found_description\":\"Sorry, we couldn't find the page you're looking for.\",\"not_found_go_home\":\"Go to Homepage\",\"not_found_go_chat\":\"Go to Chat\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L20\"}]\n17:[\"$\",\"$L1f\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"Auth\":\"$16:props:messages:Auth\",\"Toast\":\"$16:props:messages:Toast\",\"CookieConsent\":\"$16:props:messages:CookieConsent\",\"AuthError\":\"$16:props:messages:AuthError\",\"EmailConfirmation\":\"$16:props:messages:EmailConfirmation\",\"NotFound\":\"$16:props:messages:NotFound\"},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":[\"$\",\"$L21\",null,{}]}]\n22:T521,## Invoice summary\n\nI reviewed **10 invoices** and found **€18,740 outstanding**. **€5,450** is due this week, so I would prioritize those payments before scheduling the rest.\n\n### Vendor breakdown\n\n- **Acme Design Studio:** €6,800 across January, April, and August. This is your largest vendor at **36%** of total spend.\n- **CloudHost Pro:** €4,250 across February, May, and September. This looks recurring, averaging **€1,417** per invoice.\n- **Northwind Legal:** €3,100 across March and July, with the larger July invoice due soon.\n- **Stripe Atlas Services:** €2,450 in October.\n- **Bright Office Supply:** €2,140 in June.\n\n### Pay first\n\n- **Acme Design Studio:** €2,400 due from the April invoice.\n- **Northwind Legal:** €1,700 due from the July invoice.\n- **CloudHost Pro:** €1,350 due from the September invoice.\n\nAfter those, schedule the remaining **€13,290** by due date, grouped by vendor so recurring suppliers stay current.\n\n### Checks and notes\n\n- I do not see duplicate invoice numbers across the 10 files.\n- The June office supply invoice is unusually high compared with other non-service spend and is worth confirming before payment.\n- Acme and CloudHost together account for **59%** of the outstanding balance, so they are the main vendors to review for budget variance.")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("1d:[\"$\",\"$L1f\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"FeatureHighlights\":{\"feature_highlights_title_prefix\":\"Everything you need\",\"feature_highlights_title_accent\":\"in one place\",\"feature_highlights_subtitle\":\"Powerful features designed to enhance your AI experience\",\"feature_highlights_title_1\":\"Multi‑LLM Access\",\"feature_highlights_description_1\":\"Tap into the power of multiple AI models from one place\",\"feature_highlights_text_4\":\"Communicate in over 25 languages with automatic translation and language detection. Break down language barriers in your work and personal projects.\",\"feature_highlights_text_1\":\"Compare responses from different models side by side to find the best solution for your specific needs. Easily switch between models without changing platforms.\",\"feature_highlights_title_2\":\"Model Selection by Task\",\"feature_highlights_description_2\":\"Pick the best LLM for research, coding, writing, image generation, or any other task\",\"feature_highlights_text_2\":\"Generate, edit, and analyze images with the same interface you use for text. Perfect for creative projects and visual content creation.\",\"feature_highlights_title_3\":\"Voice-Enabled Commands\",\"feature_highlights_description_3\":\"Use your voice to interact with any AI model\",\"feature_highlights_text_3\":\"Talk naturally with your AI assistant and get text responses or have them read back to you. Great for multitasking and accessibility.\",\"feature_highlights_title_4\":\"25+ Languages Supported\",\"feature_highlights_description_4\":\"Speak your language — literally\"},\"Pricing\":{\"pricing_title\":\"Pricing\",\"pricing_subtitle\":\"Choose the plan that's right for you\",\"pricing_most_popular\":\"Most popular\",\"label_plan_name_biweekly\":\"Biweekly\",\"label_plan_name_monthly\":\"Monthly\",\"label_plan_name_quarterly\":\"Quarterly\",\"label_plan_name_half_yearly\":\"Half-Year\",\"label_plan_name_superpro_monthly\":\"Super Pro Monthly\",\"label_plan_name_power_monthly\":\"Max Plan\",\"label_plan_name_trial\":\"Trial\",\"label_plan_name_pro_monthly\":\"Monthly Pro\",\"label_plan_name_pro_quarterly\":\"Quarterly Pro\",\"label_plan_name_pro_half_yearly\":\"6-Month Pro\",\"label_plan_name_max_monthly\":\"Monthly Max\",\"label_plan_name_max_quarterly\":\"Quarterly Max\",\"label_plan_name_max_half_yearly\":\"6-Month Max\",\"plan_biweekly\":\"Biweekly subscription\",\"plan_monthly\":\"Monthly subscription\",\"plan_quarterly\":\"Quarterly subscription\",\"plan_half_yearly\":\"6 months subscription\",\"feature_access_to_100_llm_models\":\"Access to 12+ LLM models\",\"feature_billed_every_2_weeks\":\"Billed every 2 weeks\",\"feature_billed_every_month\":\"Billed every month\",\"feature_billed_every_3_months\":\"Billed every 3 months\",\"feature_billed_every_6_months\":\"Billed every 6 months\",\"label_biweekly\":\"biweekly\",\"label_monthly\":\"monthly\",\"label_quarterly\":\"3 months\",\"label_half_yearly\":\"6 months\",\"label_see_detailed_pricing\":\"See our detailed pricing\",\"price_excludes_tax\":\"Price excludes tax.\",\"start_trial\":\"Start \u003cnowrap\u003e{price}\u003c/nowrap\u003e Trial\",\"btn_get_started\":\"Get Started\",\"plan_trial_price_line\":\"for {days} days trial\",\"plan_trial_renewal_alt\":\"Then \u003cstrong\u003e{price}\u003c/strong\u003e per month\",\"plan_trial_autorenew_alt\":\"Auto renews after {days} days trial. Cancel anytime from your profile settings.\",\"period_every_quarter\":\"every quarter\",\"period_every_half_year\":\"every 6 months\",\"period_every_month\":\"every month\",\"label_month\":\"month\",\"plan_power_title\":\"Max Plan\",\"feature_highest_token_limits\":\"Highest token limits\"},\"PricingFaq\":{\"pricing_faq_is_it_free_to_use\":\"Is it free to use?\",\"pricing_faq_is_it_free_to_use_answer\":\"You can start with 1 free message to try the platform. For unlimited access, you can choose our $1.00 seven-day trial or subscribe to one of our paid plans starting at $29.99 monthly.\",\"pricing_faq_what_if_im_not_satisfied_with_the_product\":\"What if I'm not satisfied with the product?\",\"pricing_faq_what_if_im_not_satisfied_with_the_product_answer\":\"We offer a $1.00 trial to help you evaluate our service before committing to a full subscription. Please review our\",\"pricing_faq_what_if_im_not_satisfied_with_the_product_answer_after\":\"for detailed information about our cancellation terms.\",\"pricing_faq_how_do_i_cancel_my_subscription\":\"How do I cancel my subscription?\",\"pricing_faq_how_do_i_cancel_my_subscription_answer\":\"You can cancel your subscription anytime through our\",\"pricing_faq_how_do_i_cancel_my_subscription_link_text\":\"Cancellation Hub.\",\"pricing_faq_how_do_i_cancel_my_subscription_after\":\"Remember to cancel at least 24 hours before your next billing cycle to avoid charges.\",\"pricing_faq_what_are_the_main_features_of_the_app\":\"What are the main features of the app?\",\"pricing_faq_what_are_the_main_features_of_the_app_answer\":\"Our platform provides access to popular AI models through a single interface with text chat, voice-to-text input, PDF and image analysis capabilities. You can seamlessly switch between different AI models mid-conversation and get insights from your AI assistant.\",\"pricing_faq_which_ai_models_are_available_on_the_app\":\"Which AI models are available on the app?\",\"pricing_faq_which_ai_models_are_available_on_the_app_answer\":\"We offer access to the most popular and powerful AI models from leading providers (including GPT-6 Astra, Claude Fable 5.1, Gemini 3.8 Flash, and more), all accessible through one unified interface. You can switch between models during conversations to find the best one for your specific needs.\",\"pricing_faq_are_there_any_hidden_fees\":\"Are there any hidden fees?\",\"pricing_faq_are_there_any_hidden_fees_answer\":\"No hidden fees. Our pricing is transparent with clear subscription rates starting at $29.99 monthly or $49.99 quarterly.\",\"pricing_faq_is_my_data_secure\":\"Is my data secure?\",\"pricing_faq_is_my_data_secure_answer\":\"Yes, we prioritize data security and privacy. Your conversations and personal information are protected with industry-standard encryption and security measures. We do not share your data with third parties without your consent.\",\"pricing_faq_title\":\"Frequently Asked Questions\",\"footer_terms_and_conditions\":\"Terms \u0026 Conditions\"},\"Footer\":{\"footer_customer_support\":\"Customer Support\",\"footer_cancel_subscription\":\"Cancel Subscription\",\"footer_privacy_policy\":\"Privacy Policy\",\"footer_terms_and_conditions\":\"Terms \u0026 Conditions\",\"footer_cookie_policy\":\"Cookie Policy\",\"footer_refund_policy\":\"Refund Policy\",\"footer_help_center\":\"Help Center\",\"footer_pricing\":\"Plans \u0026 Pricing\",\"footer_copyright\":\"© {currentYear} {companyName} All rights reserved. All trademarks are the property of their respective owners.\",\"footer_legal\":\"Legal\",\"footer_disclaimer\":\"Use AI provides access to third-party AI models. We are not affiliated with, endorsed by, or the owner of these models.\",\"footer_help\":\"Help\",\"footer_product\":\"Product\",\"theme_dark\":\"Dark\",\"theme_light\":\"Light\",\"theme_system\":\"System\",\"footer_download\":\"Download\"},\"SelectLanguage\":{\"label_select_language\":\"Select Language\"},\"ShareChatInvite\":{\"error_unauthorized\":\"Unauthorized\",\"error_invalid_payload\":\"Invalid payload\",\"error_chat_not_found\":\"Chat not found\",\"error_not_owner\":\"User is not the owner of the chat\",\"error_invitation_already_sent\":\"Invitation already sent to this user\",\"error_cannot_share_with_yourself\":\"You cannot share the chat with yourself\",\"error_send_failed\":\"Failed to send share chat invite email\"},\"SubscriptionCancel\":{\"subscription_cancel_title\":\"Cancel Your Subscription\",\"subscription_cancel_description\":\"Are you sure you want to cancel? You'll lose access to all premium features once your subscription ends.\",\"subscription_cancel_no_subscription_title\":\"No Subscription Active\",\"subscription_cancel_no_subscription_description\":\"Please double-check the email address you used to sign up - you may have registered with a different one.\\nIf you need help, contact us over email at \",\"subscription_cancel_confirm_title\":\"You're currently on our {planName} Plan\",\"subscription_cancel_confirm_description\":\"Are you sure you want to cancel your subscription? You'll lose access to all premium features at the end of your billing period.\",\"subscription_cancel_confirm_keep_plan\":\"Keep Current Plan\",\"subscription_cancel_success_title\":\"Subscription Cancelled\",\"subscription_cancel_success_description\":\"Your subscription has been cancelled. Our team is sad to see you leave. You will still have access until {formattedEndDate}, after that you won't be charged again, and your access will end.\",\"subscription_cancel_success_description_2\":\"If you need to save any data, make sure to do so before then. We'll send you an email confirmation soon.\",\"subscription_cancel_success_return_home\":\"Return Home\",\"subscription_scheduled_cancellation_title\":\"Subscription Canceled\",\"subscription_scheduled_cancellation_description\":\"Your subscription has been successfully canceled. You will continue to have access until\",\"subscription_scheduled_cancellation_access_continues\":\"You can continue using all premium features until this date.\",\"label_error\":\"Error\",\"label_success\":\"Success\",\"toast_description_subscription_cancel_failed\":\"Failed to cancel subscription. Please try again.\",\"toast_description_subscription_reactivated\":\"Your subscription has been reactivated. No changes will be made to your plan.\",\"toast_description_reactivation_failed\":\"Failed to reactivate subscription. Please try again.\",\"scheduled_downgrade_title\":\"Plan Change Scheduled\",\"scheduled_downgrade_description\":\"Your plan will be changed from {fromPlan} to {toPlan} on {date}.\",\"scheduled_downgrade_access_continues\":\"You will continue to have access to all your current plan features until this date.\",\"btn_cancel_scheduled_change\":\"Keep Current Plan\",\"btn_reactivate_subscription\":\"Reactivate my subscription\",\"btn_continue_using_service\":\"Go back to chat\",\"btn_share_your_feedback\":\"Share Your Feedback\",\"subscription_cancel_feedback_prompt\":\"Share why you left by clicking the button.\",\"btn_keep_subscription\":\"No, Keep My Subscription\",\"btn_yes_cancel_subscription\":\"Yes, Cancel My Subscription\",\"checkout_click_disclaimer\":\"By clicking {button}, we'll charge {amount} to your payment method on file.\",\"discount_success_next_billing_date\":\"Next billing date will be on\",\"discount_success_your_new_plan\":\"Your new plan:\",\"subscription_scheduled_success_title\":\"Subscription Scheduled for Cancellation\",\"subscription_scheduled_success_description\":\"Your subscription has been scheduled for cancellation. You'll continue to have full access to all premium features until {formattedEndDate}.\",\"subscription_scheduled_success_description_2\":\"You can continue using the service normally until the cancellation date. If you change your mind, you can reactivate your subscription at any time before then.\",\"reactivation_success_title\":\"Congrats! Your subscription has been reactivated\",\"reactivation_success_description\":\"Your subscription has been successfully reactivated.\",\"reactivation_success_next_billing\":\"Your next billing date is {date}.\",\"reactivation_success_billing_price\":\"You will be charged {price}.\",\"reactivation_success_cancel_anytime\":\"You can cancel any time.\",\"btn_go_to_chat\":\"Go to chat\",\"btn_cancel\":\"Cancel\",\"label_subscription\":\"Subscription\",\"biweekly\":\"Biweekly\",\"monthly\":\"Monthly\",\"quarterly\":\"Quarterly\",\"label_plan_name_quarterly\":\"Quarterly\",\"label_plan_name_biweekly\":\"Biweekly\",\"label_plan_name_monthly\":\"Monthly\",\"label_plan_name_superpro_monthly\":\"Super Pro Monthly\",\"label_plan_name_power_monthly\":\"Max Plan\",\"label_quarterly\":\"3 months\",\"label_biweekly\":\"biweekly\",\"label_monthly\":\"monthly\",\"subscription_cancel_signin_header\":\"Cancel Your Subscription\",\"subscription_cancel_signin_description\":\"Enter the email address associated with your account.\",\"subscription_cancel_continue_text\":\"Continue\",\"subscription_cancel_or_continue_with\":\"Or continue with\",\"subscription_plan_update_scheduled\":\"Your plan will be updated on {date} to {plan}\"},\"AccountDelete\":{\"account_delete_title\":\"Delete Your Account\",\"account_delete_description\":\"You'll lose access to all your data and this action cannot be undone.\",\"signin_header\":\"Delete Your Account\",\"signin_description\":\"Enter the email address associated with your account.\",\"signin_continue_text\":\"Continue\",\"signin_or_continue_with\":\"Or continue with\",\"btn_keep_account\":\"No, Keep My Account\",\"btn_yes_delete_account\":\"Yes, Delete My Account\",\"confirm_title\":\"Are you sure?\",\"confirm_description\":\"This action is permanent. All your data will be removed and cannot be recovered.\",\"confirm_wait\":\"{seconds}s\",\"btn_go_back\":\"No, Go Back\",\"btn_confirm_delete_account\":\"Yes, Delete My Account\",\"toast_description_account_deleted\":\"Account deletion confirmed. Signing you out.\",\"toast_description_account_deletion_failed\":\"Failed to initiate account deletion\"},\"ReactivateSubscription\":{\"label_success\":\"Success\",\"label_error\":\"Error\",\"toast_description_subscription_reactivated\":\"Your subscription has been reactivated successfully!\",\"toast_description_subscription_reactivated_failed\":\"Failed to reactivate subscription. Please try again.\",\"toast_description_subscription_reactivated_failed_2\":\"No subscription found to reactivate\",\"toast_description_subscription_ended\":\"This subscription has already ended and can't be reactivated. Choose a plan to subscribe again.\",\"toast_description_reactivation_in_progress\":\"Your subscription is already being updated. Please wait a moment and check again.\"},\"MobileSubscription\":{\"title_app_store\":\"Manage your plan in the App Store\",\"title_play_store\":\"Manage your plan in Google Play\",\"title_unknown\":\"Manage your plan in the mobile app\",\"description_app_store\":\"You signed up for Use AI through Apple's App Store. This plan can't be changed, canceled, or managed on the web. Open the App Store to make changes.\",\"description_play_store\":\"You signed up for Use AI through Google Play. This plan can't be changed, canceled, or managed on the web. Open Google Play to make changes.\",\"description_unknown\":\"You signed up for use.ai through the mobile app. This plan can't be changed, canceled, or managed on the web. Open your device's app store to make changes.\",\"label_your_plan\":\"Your plan\",\"label_signed_up_through\":\"Signed up through\",\"store_name_app_store\":\"App Store\",\"store_name_play_store\":\"Google Play\",\"button_close\":\"Close\"},\"GlobalError\":{\"global_error_title\":\"We're doing some quick improvements\",\"global_error_description_1\":\"The service is temporarily unavailable, but we're on it. Try refreshing the page as it usually resolves the issue.\",\"global_error_description_2\":\"If the problem continues, our support team can help.\",\"global_error_sign_in\":\"Try again\",\"error_hard_refresh\":\"Hard refresh\"},\"EmailLogin\":{\"api_email_login_processing_failed\":\"Failed to process email login\",\"api_email_login_rate_limit_exceeded\":\"You've requested several links recently. Please use the most recent one we sent — it's still valid. You'll be able to request another link again soon.\",\"api_email_login_check_email_magic_link\":\"Please check your email for the magic link\",\"api_email_login_creating_account\":\"Email validated. Creating your account…\",\"api_email_login_invalid_email_address\":\"This e-mail address is not valid. Please try another one.\"},\"AuthError\":\"$16:props:messages:AuthError\",\"NotFound\":\"$16:props:messages:NotFound\",\"Help\":{\"help_center_title\":\"Help Center\",\"help_center_main_title\":\"Help Center\",\"help_no_articles_category\":\"No articles available in this category.\",\"help_search_placeholder\":\"Search in {category}…\",\"help_search_all_placeholder\":\"Search help articles\",\"help_read_article\":\"Read article →\",\"help_no_articles_found\":\"No articles found\",\"help_no_articles_yet\":\"There are no articles in this category yet.\",\"help_last_updated\":\"Last updated:\",\"help_back_to_category\":\"Back to {category}\",\"help_tags\":\"Tags\",\"help_articles\":\"articles\",\"help_article\":\"article\",\"help_on_this_page\":\"On this page\",\"help_sections\":\"sections\",\"help_usage_limits_card_title\":\"How usage limits work\",\"help_usage_limits_card_link\":\"See what each plan includes\",\"help_related_articles\":\"Related articles\",\"help_featured_title\":\"Featured articles\"},\"Auth\":\"$16:props:messages:Auth\",\"Models\":{\"label_available_models\":\"Available Models\",\"label_see_all\":\"See All\",\"toast_description_models_get_error\":\"Failed to fetch models\",\"model_card_selected\":\"Selected\",\"model_sonnet_5_subtitle\":\"Claude's frontier Sonnet\",\"model_fable_5_1_subtitle\":\"Claude's newest, most powerful\",\"model_glm