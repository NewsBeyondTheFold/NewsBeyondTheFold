missions\",\"detail_details_label\":\"Details\",\"detail_version\":\"Version\",\"detail_provider\":\"Provider\",\"detail_auth_type\":\"Auth Type\",\"detail_access\":\"Access\",\"detail_tools_description\":\"Choose when Use.ai is allowed to use these tools\",\"detail_read_tools\":\"Read-only tools\",\"detail_write_actions\":\"Write tools\",\"permission_allow\":\"Allow\",\"permission_ask\":\"Ask\",\"permission_deny\":\"Deny\",\"permission_aria\":\"Permission for {tool}\",\"toast_permission_update_failed\":\"Couldn't save permission. Please try again.\",\"disconnect_title\":\"Disconnect {name}?\",\"disconnect_description\":\"Are you sure you want to disconnect from {name}? \u003cstrong\u003eThis will remove access to all related tools.\u003c/strong\u003e\",\"disconnect_aria\":\"Disconnect {name}\",\"toggle_disable_for_chat_aria\":\"Disable {name} for this chat\",\"toggle_enable_for_chat_aria\":\"Enable {name} for this chat\",\"sr_disconnect_title\":\"Disconnect connector\",\"sr_disconnect_confirm\":\"Disconnect confirm\",\"disconnect_confirm_description\":\"The agent will lose access to your emails.\",\"disconnect_confirm_button\":\"Disconnect\",\"connect_notify_title\":\"Connecting to {name}\",\"connect_notify_description\":\"Allow Use.ai to access your {name} account\",\"connect_notify_redirecting\":\"Redirecting to {name} to authorize access…\",\"sr_connect_title\":\"Connecting\",\"sr_connect_description\":\"Redirecting to authorize\",\"api_key_connect_title\":\"Connect to {name}\",\"api_key_connect_description\":\"Paste your {name} API key to connect your account\",\"api_key_field_label\":\"API key\",\"api_key_field_placeholder\":\"Paste your API key\",\"api_key_submit\":\"Connect\",\"api_key_where_to_find\":\"Where do I find my API key?\",\"api_key_required\":\"Enter your API key to continue.\",\"api_key_error_generic\":\"Could not connect. Check your key and try again.\",\"access_read_only\":\"Read-only access\",\"access_read_write\":\"Read and write access\",\"access_write_only\":\"Write access\",\"access_denied\":\"Access denied\",\"more_coming_soon\":\"More coming weekly\",\"what_you_unlock\":\"What you unlock\",\"what_you_can_ask\":\"What you can ask\",\"category_all\":\"All\",\"category_analytics\":\"Analytics\",\"category_automation\":\"Automation\",\"category_commerce\":\"Commerce\",\"category_communication\":\"Communication\",\"category_content\":\"Content\",\"category_developer\":\"Developer\",\"category_finance\":\"Finance\",\"category_marketing\":\"Marketing\",\"category_media\":\"Media\",\"category_monitoring\":\"Monitoring\",\"category_productivity\":\"Productivity\",\"category_sales\":\"Sales\",\"category_support\":\"Support\",\"manage\":\"Manage\"},\"ConnectorsPromoBanner\":{\"title\":\"Connect your apps to Use.ai\",\"description\":\"Connecting apps like Notion and Slack allows you to get more done directly with Use.ai\",\"cta\":\"Connect\",\"dismiss\":\"Dismiss banner\"},\"ToolCall\":{\"clock\":{\"current_time\":\"Current time\",\"getting_current_time\":\"Getting current time…\",\"weekday_monday\":\"Monday\",\"weekday_tuesday\":\"Tuesday\",\"weekday_wednesday\":\"Wednesday\",\"weekday_thursday\":\"Thursday\",\"weekday_friday\":\"Friday\",\"weekday_saturday\":\"Saturday\",\"weekday_sunday\":\"Sunday\"},\"common\":{\"show_less\":\"Show less\",\"show_more\":\"Show more\",\"searching\":\"Searching…\",\"searching_for\":\"Searching for \\\"{query}\\\"\",\"running\":\"Running…\",\"no_response\":\"No response\",\"no_response_timed\":\"No response ({seconds}s)\",\"no_response_after_seconds\":\"No response after {seconds}s\",\"search_completed\":\"Search completed\",\"executing\":\"Executing tool…\",\"no_details\":\"No details available\",\"result\":\"Result\",\"failed\":\"{name} failed to execute.\",\"failed_short\":\"{name} failed.\",\"timed_out\":\"{name} did not respond after {seconds}s.\",\"did_not_respond\":\"{name} did not respond.\",\"output\":\"Output\",\"hide_data\":\"Hide data\",\"view_full_data\":\"View full data\",\"show_all_results_one\":\"Show all {count} result\",\"show_all_results_other\":\"Show all {count} results\",\"status_running\":\"Running…\",\"status_no_response\":\"No response ({seconds}s)\",\"status_failed\":\"Failed\",\"status_error\":\"Error\",\"status_success\":\"Success\",\"status_done\":\"Done\",\"source_count_one\":\"{count} source\",\"source_count_other\":\"{count} sources\",\"copy\":\"Copy\",\"calling_tool\":\"Calling tool\",\"calling_tool_loading\":\"Calling tool…\",\"pre_market\":\"Pre-market:\",\"stock_low\":\"Low\",\"stock_high\":\"High\",\"data_points\":\"{count} data points\",\"error_connector_title\":\"Connector needs attention\",\"error_recoverable_title\":\"Looking something up first\",\"error_tool_unavailable_title\":\"Tool unavailable\",\"error_connector_desc\":\"Reconnect this connector and try again.\",\"error_recoverable_desc\":\"The assistant needs to fetch a missing detail and will retry on the next step.\",\"error_tool_unavailable_desc\":\"The tool could not complete. Try again in a moment or check the connector settings.\",\"error_generic\":\"Something went wrong.\",\"took_too_long\":\"Took too long\",\"couldnt_load\":\"Couldn't load\",\"tool_count_one\":\"{count} tool\",\"tool_count_other\":\"{count} tools\",\"bool_yes\":\"Yes\",\"bool_no\":\"No\",\"approval_create_page_q\":\"Create page?\",\"approval_create_page\":\"Create page\",\"approval_add_content_q\":\"Add content?\",\"approval_add_content\":\"Add content\",\"approval_insert_row_q\":\"Insert row?\",\"approval_insert_row\":\"Insert row\",\"approval_update_row_q\":\"Update row?\",\"approval_update_row\":\"Update row\",\"tool_ask_clarification\":\"Asking clarifying questions\"},\"webSearch\":{\"toolkit_title\":\"Web Search\",\"idle\":\"Searched the web\",\"idle_stopped\":\"Web search stopped\",\"idle_failed\":\"Web search failed\",\"loading\":\"Searching the web\",\"entry_fallback\":\"Web search\",\"entry_fallback_loading\":\"Searching…\",\"show_all_sources_one\":\"Show all {count} source\",\"show_all_sources_other\":\"Show all {count} sources\",\"show_fewer\":\"Show fewer\",\"source_count_one\":\"{count} source\",\"source_count_other\":\"{count} sources\"},\"extractPages\":{\"idle\":\"Read web pages\",\"idle_failed\":\"Page reading failed\",\"loading\":\"Reading pages\",\"entry_fallback\":\"Read pages\",\"entry_fallback_loading\":\"Reading…\",\"page_count_one\":\"{count} page\",\"page_count_other\":\"{count} pages\",\"show_all_one\":\"Show all {count} page\",\"show_all_other\":\"Show all {count} pages\",\"show_fewer\":\"Show fewer\"},\"knowledgeBase\":{\"toolkit_title\":\"Knowledge Base\",\"idle\":\"Searched knowledge base\",\"idle_stopped\":\"Knowledge base search stopped\",\"idle_failed\":\"Knowledge base search failed\",\"loading\":\"Searching knowledge base\",\"entry_fallback\":\"Knowledge base search\",\"no_results\":\"no results\",\"result_count_one\":\"{count} result\",\"result_count_other\":\"{count} results\",\"file_count_one\":\"{count} file\",\"file_count_other\":\"{count} files\",\"snippet_count_one\":\"{count} snippet\",\"snippet_count_other\":\"{count} snippets\",\"no_matching_content\":\"No matching content found in your knowledge base.\",\"not_indexed_yet\":\"Still being indexed\",\"not_indexed_yet_hint\":\"This file hasn't been processed yet. Try again in a moment.\",\"collapse_snippet\":\"Collapse snippet\",\"expand_snippet\":\"Expand snippet\"},\"searchFiles\":{\"toolkit_title\":\"File Search\",\"idle\":\"Searched files\",\"idle_failed\":\"File search failed\",\"idle_stopped\":\"File search stopped\",\"loading\":\"Searching files\",\"entry_fallback\":\"File search\",\"no_results\":\"no results\",\"result_count_one\":\"{count} file\",\"result_count_other\":\"{count} files\",\"no_matching_content\":\"No matching content found in the attached files.\"},\"codeWorkspace\":{\"toolkit_title\":\"Workspace\",\"run_code\":\"Running code\",\"fs_list_files\":\"Checking your files\",\"fs_read_file\":\"Reading a file\",\"fs_grep_files\":\"Searching your files\",\"fs_write_file\":\"Writing a file\",\"fs_edit_file\":\"Editing a file\",\"fs_delete_file\":\"Removing a file\",\"fs_add_attachment\":\"Adding files to the workspace\",\"working\":\"Working on it\",\"failed\":\"Something went wrong\",\"failed_step\":\"I wasn't able to finish this step.\",\"sandbox_trust\":\"Runs in a private sandbox with access only to this chat's files — no internet, no accounts.\",\"generated_image_alt\":\"Generated image\"}},\"CookieConsent\":\"$16:props:messages:CookieConsent\",\"ImageSurpriseMePrompts\":{\"prompt_1\":\"A golden retriever wearing a astronaut suit floating in space with Earth in the background\",\"prompt_2\":\"A cozy cabin in a snowy forest at night with warm light glowing from the windows\",\"prompt_3\":\"A futuristic city skyline at sunset with flying cars and neon lights reflecting on the water\",\"prompt_4\":\"A majestic lion with a floral crown sitting in a field of sunflowers\",\"prompt_5\":\"A steampunk octopus with brass goggles and mechanical tentacles in a Victorian library\",\"prompt_6\":\"An enchanted mushroom village with tiny fairy doors and glowing lanterns at dusk\",\"prompt_7\":\"A samurai cat in full armor standing on a misty mountain peak at sunrise\",\"prompt_8\":\"A giant sea turtle with a lush jungle and waterfall on its shell swimming through the ocean\",\"prompt_9\":\"A neon-lit ramen shop in Tokyo on a rainy night with reflections on the wet street\",\"prompt_10\":\"A polar bear reading a book in an armchair next to a fireplace inside an igloo\",\"prompt_11\":\"A dragon made entirely of cherry blossom petals flying over a Japanese temple\",\"prompt_12\":\"A lighthouse on a cliff during a dramatic lightning storm with crashing waves below\",\"prompt_13\":\"A French bulldog dressed as a Renaissance painter with a tiny palette and beret\",\"prompt_14\":\"An underwater city with glass domes, coral streets, and mermaids going about daily life\",\"prompt_15\":\"A wolf howling at a full moon in a forest where the trees are made of crystal\",\"prompt_16\":\"A vintage hot air balloon floating above lavender fields in the Provence countryside\",\"prompt_17\":\"A robot tending to a beautiful rooftop garden in a futuristic metropolis\",\"prompt_18\":\"A magical bookshop where the books float off the shelves and pages fly through the air\",\"prompt_19\":\"A snow leopard perched on a Himalayan peak surrounded by swirling clouds and stars\",\"prompt_20\":\"A tiny astronaut discovering a miniature alien civilization on a glowing mushroom planet\",\"prompt_21\":\"A watercolor painting of a rainy Paris street with couples under colorful umbrellas\",\"prompt_22\":\"A phoenix rising from golden flames against a deep purple twilight sky\",\"prompt_23\":\"A corgi surfing a massive wave at sunset with a rainbow in the background\",\"prompt_24\":\"A medieval knight riding a bicycle through a modern city looking confused\",\"prompt_25\":\"An art deco hotel lobby with palm trees, geometric floors, and a grand chandelier\",\"prompt_26\":\"A fox wearing a detective coat investigating a mysterious glowing door in an autumn forest\",\"prompt_27\":\"A giant whale soaring through clouds above a mountain range at golden hour\",\"prompt_28\":\"A futuristic greenhouse on Mars with exotic alien plants and a view of the red landscape\",\"prompt_29\":\"A black cat sitting on a stack of ancient spell books surrounded by floating candles\",\"prompt_30\":\"A little girl and a giant friendly robot sharing an umbrella in a flower-filled meadow\"},\"FilesManagement\":{\"page_title\":\"Files\",\"collections\":\"Collections\",\"create_collection_title\":\"New collection\",\"create_collection_placeholder\":\"Name your collection\",\"collection_name_label\":\"Name\",\"create_collection_hint\":\"Group files and sources to attach to any chat.\",\"create_collection_error\":\"Collection names cannot be longer than 50 characters.\",\"collection_duplicate_error\":\"A collection with this name already exists.\",\"collection_files_count\":\"{count, plural, =0 {No files} one {# file} other {# files}}\",\"file_duplicate_error\":\"A file with this name already exists.\",\"create_collection_button_title\":\"Create collection\",\"create_collection_loading\":\"Creating\",\"add_files\":\"Add files\",\"select_collections\":\"Select collections\",\"select_files\":\"Select files\",\"btn_new_collection\":\"New collection\",\"btn_create_first_collection\":\"Create your first collection\",\"last_update\":\"Last update\",\"size\":\"Size\",\"latest_files\":\"Latest files\",\"count_size_summary\":\"{count, plural, one {# file} other {# files}} · {size}\",\"updated_at\":\"Updated {date}\",\"back\":\"Back\",\"empty_collections_title\":\"No collections yet\",\"empty_collections_description\":\"Group files into collections and attach them to any chat.\",\"btn_upload_files\":\"Upload files\",\"files\":\"Files\",\"empty_files_title\":\"No files yet\",\"empty_files_description\":\"Upload files to this collection and attach them as context in your chats\",\"drag_drop_description\":\"Drop any file here to upload\",\"uploading\":\"Uploading…\",\"processing\":\"Processing…\",\"rename_collection_modal_title\":\"Rename Collection\",\"rename_title_placeholder\":\"Enter new title\",\"selected_count\":\"{count} selected\",\"download_all\":\"Download all\",\"delete_all\":\"Delete all\",\"delete_confirm_description\":\"This action cannot be undone.\",\"delete_items_title\":\"Delete {count, plural, one {# item} other {# items}}?\",\"delete_items_btn\":\"Delete {count}\",\"no_files_in_collection\":\"No files in this collection.\",\"btn_add\":\"Add\",\"btn_download\":\"Download\",\"file_preview_size_warning\":\"Showing first 500 KB\",\"create_new_collection\":\"Create new collection\",\"create_collection_description\":\"Organize files in collections\",\"selected_collections_count\":\"{count, plural, one {# collection} other {# collections}}\",\"selected_files_count\":\"{count, plural, one {# file} other {# files}}\",\"search_collections_placeholder\":\"Search collections\",\"search_files_placeholder\":\"Search files\",\"select_all\":\"Select all\",\"select_all_with_count\":\"Select all ({count})\",\"btn_add_files\":\"{count, plural, one {Add # file} other {Add # files}}\",\"zero_files_selected\":\"0 files selected\",\"collection_new_chat_tooltip\":\"Start new chat with this collection of files. AI will analyze the files from the collection before giving you answers\",\"landing_title\":\"Chat with your files\",\"landing_subtitle\":\"Create a collection, add your files, and attach it to any chat. Use AI to search, summarize, and answer with your sources.\",\"landing_see_how\":\"See how it works\",\"landing_closing_title\":\"Ready to chat with your files?\",\"landing_closing_desc\":\"Create a collection and start using your files as chat context.\",\"landing_replay\":\"Watch again\",\"step_create_title\":\"Create a collection\",\"step_create_desc\":\"Group related files together.\",\"step_upload_title\":\"Upload files\",\"step_upload_desc\":\"PDFs, docs, sheets — anything\",\"step_attach_title\":\"Attach to a chat\",\"step_attach_desc\":\"Add it to any conversation.\",\"step_answers_title\":\"Get answers\",\"step_answers_desc\":\"Use AI reads them and replies.\",\"landing_label_new\":\"New\",\"landing_demo_collection_name\":\"Invoices 2025\",\"landing_demo_prompt\":\"Analyse these 10 invoices and give a breakdown of how much I need to pay and to who\",\"landing_demo_answer\":\"$22\",\"landing_demo_file_count\":\"{count, plural, one {# file} other {# files}}\",\"landing_demo_file_date\":\"Jun 2025\",\"landing_cancel\":\"Cancel\",\"landing_attach_file\":\"Attach file\",\"landing_message_placeholder\":\"Message Use AI…\",\"landing_search_collection_status\":\"Searching collection information…\",\"landing_sources\":\"Sources\",\"landing_drop_title\":\"Add anything\",\"landing_finder_downloads\":\"Downloads\",\"landing_finder_kind\":\"Kind\",\"landing_