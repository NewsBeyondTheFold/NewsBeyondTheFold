  .gpay-card-info-container-fill .gpay-card-info-placeholder-container {
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-top: 3px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .gpay-card-info-container-fill .gpay-card-info-placeholder-svg-container{
    position: relative;
    width: 60%;
    height: inherit;
    max-height: 80%;
    margin-right: -20%;
  }

  .gpay-card-info-container-fill .gpay-card-info-placeholder-svg-container > svg {
    position: absolute;
    left: 0;
    height: 100%;
    max-width: 100%;
  }

  /* Opt out of browser forced-colors recoloring because GPay button brand colors and borders are already high-contrast friendly. */
  @media (forced-colors: active) {
    .gpay-card-info-container,
    .gpay-card-info-animation-container {
      forced-color-adjust: none !important;
    }

    .gpay-card-info-container *,
    .gpay-card-info-animation-container * {
      forced-color-adjust: none !important;
